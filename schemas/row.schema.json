{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "step",
    "phase",
    "condition",
    "schedule",
    "score_kind",
    "requested_model",
    "served_model",
    "provider",
    "input_text",
    "prompt_sha256",
    "output_text",
    "finish_reason",
    "parameters",
    "latency_seconds",
    "prompt_tokens",
    "completion_tokens",
    "cost",
    "generation_id",
    "judge",
    "timestamp"
  ],
  "$defs": {
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "verdict"],
      "properties": {
        "id": {"type": "string"},
        "verdict": {
          "enum": ["supported", "contradicted", "not_mentioned"]
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "anchored",
        "verdicts",
        "error",
        "prompt_tokens",
        "completion_tokens",
        "cost",
        "generation_id",
        "requested_model",
        "served_model",
        "provider",
        "finish_reason",
        "seed",
        "top_p",
        "seed_honored"
      ],
      "properties": {
        "score": {"type": ["integer", "null"]},
        "anchored": {"type": ["integer", "null"]},
        "verdicts": {
          "type": "array",
          "items": {"$ref": "#/$defs/verdict"}
        },
        "error": {"type": ["string", "null"]},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "cost": {"type": "number", "minimum": 0},
        "generation_id": {"type": "string"},
        "requested_model": {"type": "string"},
        "served_model": {"type": "string"},
        "provider": {"type": ["string", "null"]},
        "finish_reason": {"type": "string"},
        "seed": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "top_p": {"type": "number", "minimum": 0, "maximum": 1},
        "seed_honored": {"type": ["boolean", "null"]}
      }
    }
  },
  "properties": {
    "run_id": {"type": "string", "format": "uuid"},
    "step": {"type": "integer", "minimum": 1},
    "phase": {"enum": ["a2q", "q2a", "identity", "paraphrase"]},
    "condition": {"type": "string"},
    "schedule": {"type": "string"},
    "score_kind": {"enum": ["fidelity", "answerability"]},
    "requested_model": {"type": "string"},
    "served_model": {"type": "string"},
    "provider": {"type": ["string", "null"]},
    "input_text": {"type": "string"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_text": {"type": "string"},
    "finish_reason": {"type": "string"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "max_tokens", "top_p", "seed", "seed_honored"],
      "properties": {
        "temperature": {"type": "number"},
        "max_tokens": {"type": "integer"},
        "top_p": {"type": "number", "minimum": 0, "maximum": 1},
        "seed": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "seed_honored": {"type": ["boolean", "null"]}
      }
    },
    "latency_seconds": {"type": "number", "minimum": 0},
    "prompt_tokens": {"type": "integer", "minimum": 0},
    "completion_tokens": {"type": "integer", "minimum": 0},
    "cost": {"type": "number", "minimum": 0},
    "generation_id": {"type": "string"},
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples",
        "prev_samples",
        "errors",
        "fidelity_vs_seed",
        "fidelity_spread",
        "anchored",
        "anchored_spread",
        "fidelity_vs_prev",
        "anchored_vs_prev",
        "answerability",
        "answerability_anchored",
        "claims",
        "claim_supported",
        "claim_contradicted",
        "claim_total",
        "claim_fidelity",
        "contradiction_rate",
        "prev_claims",
        "prev_claim_fidelity",
        "prev_contradiction_rate"
      ],
      "properties": {
        "samples": {
          "type": "array",
          "items": {"$ref": "#/$defs/sample"}
        },
        "prev_samples": {
          "type": "array",
          "items": {"$ref": "#/$defs/sample"}
        },
        "errors": {"type": "integer", "minimum": 0},
        "fidelity_vs_seed": {"type": ["number", "null"]},
        "fidelity_spread": {"type": ["number", "null"]},
        "anchored": {"type": ["number", "null"]},
        "anchored_spread": {"type": ["number", "null"]},
        "fidelity_vs_prev": {"type": ["number", "null"]},
        "anchored_vs_prev": {"type": ["number", "null"]},
        "answerability": {"type": ["number", "null"]},
        "answerability_anchored": {"type": ["number", "null"]},
        "claims": {
          "type": "array",
          "items": {"$ref": "#/$defs/verdict"}
        },
        "claim_supported": {"type": ["integer", "null"]},
        "claim_contradicted": {"type": ["integer", "null"]},
        "claim_total": {"type": ["integer", "null"]},
        "claim_fidelity": {"type": ["number", "null"]},
        "contradiction_rate": {"type": ["number", "null"]},
        "prev_claims": {
          "type": "array",
          "items": {"$ref": "#/$defs/verdict"}
        },
        "prev_claim_fidelity": {"type": ["number", "null"]},
        "prev_contradiction_rate": {"type": ["number", "null"]}
      }
    },
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
